#!/usr/bin/env bash
# Runs the project's pinned Godot. Use this instead of a hardcoded binary path.
#
#   tools/godot --headless --path . --script game/tests/<test>.gd
#   tools/godot --path . --script game/tests/shared/building_shots.gd -- <args>
#
# Binary: $GODOT_BIN if set, else /opt/godot/4.7.2/godot (installed by
# .devcontainer/setup-godot.sh).
#
# Without --headless, renders on the GPU through a private headless Weston
# compositor. Under xvfb Godot silently falls back to llvmpipe (CPU), so xvfb
# is not used.
set -euo pipefail

bin="${GODOT_BIN:-/opt/godot/4.7.2/godot}"
if [ ! -x "${bin}" ]; then
  echo "tools/godot: no Godot at ${bin}; run .devcontainer/setup-godot.sh" >&2
  exit 1
fi

# Engine flags only; anything after "--" belongs to the script.
engine_args=()
for arg in "$@"; do
  [ "${arg}" = "--" ] && break
  engine_args+=("${arg}")
done
has_flag() { local flag; for flag in "${engine_args[@]}"; do [ "${flag}" = "$1" ] && return 0; done; return 1; }

if has_flag --headless; then
  exec "${bin}" "$@"
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg-$(id -u)}"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"
# A private compositor per run, so concurrent or crashed runs can't interfere.
export WAYLAND_DISPLAY="wl-godot-$$"
weston_log="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}.log"
weston --backend=headless --renderer=gl --socket="${WAYLAND_DISPLAY}" \
  --width=1920 --height=1080 >"${weston_log}" 2>&1 &
weston_pid=$!
godot_pid=""
monitor_pid=""
cleanup() {
  # Under set -e a failed kill here (a process already gone, e.g. Weston closed
  # by release_wayland_exit_hang) would replace the exit status with 1.
  [ -z "${monitor_pid}" ] || kill "${monitor_pid}" 2>/dev/null || true
  [ -z "${godot_pid}" ] || kill "${godot_pid}" 2>/dev/null || true
  kill "${weston_pid}" 2>/dev/null || true
  rm -f "${weston_log}"
}
trap cleanup EXIT
trap 'exit 143' INT TERM
for _ in $(seq 50); do
  [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ] && break
  sleep 0.1
done
if [ ! -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; then
  echo "tools/godot: Weston did not start:" >&2
  cat "${weston_log}" >&2
  exit 1
fi
# The GTK window-decoration plugin crashes inside the container.
export LIBDECOR_PLUGIN_DIR="${LIBDECOR_PLUGIN_DIR:-/nonexistent}"

extra=()
has_flag --display-driver || extra+=(--display-driver wayland)
has_flag --rendering-driver || extra+=(--rendering-driver vulkan)
# Godot 4.7.2 can hang at exit on Wayland. WaylandThread::destroy() sets
# thread_done, does one roundtrip and joins the "Wayland Events" thread, but that
# thread checks thread_done only after its poll(-1) returns (wayland_thread.cpp,
# _poll_events_thread). If the main thread reads the roundtrip reply itself, the
# events thread goes back into poll and the main thread waits in pthread_join
# forever: this headless Weston never sends anything to wake it.
# Only in that exact state, three samples in a row, close our private Weston:
# poll returns HUP, the thread exits and Godot finishes its normal shutdown with
# its own exit status. The state: the events thread in poll, and the main thread
# in a futex wait on the thread descriptor that pthread_join waits on. glibc keeps
# that descriptor in the events thread's own stack mapping; with the pinned Godot
# and glibc it sat exactly 0x2320 above the polling thread's stack pointer in
# every observed hang, so the address must be within 0x400 of that offset. If a
# different build moves it, the release simply stops firing.
release_wayland_exit_hang() {
  # /proc files can vanish or refuse access while Godot exits; keep the run's
  # stderr (saved as fd 3) for the NOTE alone.
  exec 3>&2 2>/dev/null
  set +eu
  local pid=$1 events="" task hits=0 main_nr uaddr ev_nr ev_sp offset
  mapping_of() {
    local lo hi rest
    while IFS='- ' read -r lo hi rest; do
      if (( $1 >= 0x${lo} && $1 < 0x${hi} )); then echo "${lo}"; return; fi
    done < "/proc/${pid}/maps"
  }
  while kill -0 "${pid}" 2>/dev/null; do
    # Detached from the run's output (including the saved fd 3), so an orphaned
    # sleep can't hold a caller's capture pipe open.
    sleep 2 >/dev/null 2>&1 3>&-
    if [ -z "${events}" ]; then
      for task in /proc/"${pid}"/task/*; do
        [ "$(cat "${task}/comm" 2>/dev/null)" = "Wayland Events" ] && events="${task##*/}"
      done
      continue
    fi
    # /proc/<tid>/syscall: number, six arguments, stack pointer, program counter.
    main_nr="" uaddr="" ev_nr="" ev_sp="" offset=-1
    read -r main_nr uaddr _ < "/proc/${pid}/task/${pid}/syscall"
    read -r ev_nr _ _ _ _ _ _ ev_sp _ < "/proc/${pid}/task/${events}/syscall"
    case "${uaddr}/${ev_sp}" in
      0x*/0x*) offset=$((uaddr - ev_sp)) ;;
    esac
    if [ "${main_nr}" = 202 ] && { [ "${ev_nr}" = 7 ] || [ "${ev_nr}" = 271 ]; } \
      && [ "${offset}" -ge $((0x2320 - 0x400)) ] && [ "${offset}" -le $((0x2320 + 0x400)) ] \
      && [ -n "$(mapping_of "${uaddr}")" ] && [ "$(mapping_of "${uaddr}")" = "$(mapping_of "${ev_sp}")" ]; then
      hits=$((hits + 1))
    else
      hits=0
    fi
    if [ "${hits}" -ge 3 ]; then
      echo "NOTE: tools/godot: Godot hung joining its Wayland events thread at exit; closing the private Weston so shutdown can finish" >&3
      kill "${weston_pid}" 2>/dev/null
      return
    fi
  done
}
"${bin}" "${extra[@]}" "$@" &
godot_pid=$!
release_wayland_exit_hang "${godot_pid}" &
monitor_pid=$!
status=0
wait "${godot_pid}" || status=$?
godot_pid=""
# The monitor may already have returned after a release.
kill "${monitor_pid}" 2>/dev/null || true
monitor_pid=""
exit "${status}"
