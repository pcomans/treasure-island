+extends RefCounted
+# Whole-building study from March 2025 references. No source record/collision changes.
+static func color_material(c:String,rough:float=0.82)->StandardMaterial3D:
+	var m:=StandardMaterial3D.new();m.albedo_color=Color(c);m.roughness=rough;return m
+static func cladding()->ShaderMaterial:
+	var sh:=Shader.new();sh.code="""shader_type spatial;
+	varying vec3 wp;
+	void vertex(){wp=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;}
+	void fragment(){float course=fract(wp.y/0.15);float aa=max(fwidth(wp.y/0.15),0.025);float joint=1.0-smoothstep(0.018,0.018+aa,course);ALBEDO=vec3(0.655,0.66,0.625)*(1.0-joint*0.095);ROUGHNESS=0.88;}"""
+	var m:=ShaderMaterial.new();m.shader=sh;return m
+static func box(root:Node3D,p:Vector3,size:Vector3,m:Material,angle:float=0.0)->void:
+	if size.x<0.001 or size.y<0.001 or size.z<0.001:return
+	var mesh:=BoxMesh.new();mesh.size=size;var n:=MeshInstance3D.new();n.mesh=mesh;n.material_override=m;n.position=p;n.rotation.y=angle;root.add_child(n)
+static func face(root:Node3D,pts:Array,m:Material,label:String="",orientation:Dictionary={})->void:
+	# Only crossing closure quads need a new triangulation. Preserve their four
+	# boundary endpoints; split at the actual wall-top/roof-edge intersection.
+	if label == "RoofWallClosure":
+		var ha:float = pts[3].y - pts[0].y
+		var hb:float = pts[2].y - pts[1].y
+		if ha * hb < 0.0:
+			var crossing:Vector3 = pts[0].lerp(pts[1], ha / (ha - hb))
+			var exterior:Vector3 = (pts[1]-pts[0]).cross(pts[2]-pts[0]).normalized()
+			if not orientation.is_empty() and exterior.dot(orientation.outward)<0.0:exterior=-exterior
+			var vertices := PackedVector3Array()
+			var normals := PackedVector3Array()
+			var uvs := PackedVector2Array()
+			for triangle:Array in [[pts[0], crossing, pts[3]], [crossing, pts[1], pts[2]]]:
+				var a:Vector3=triangle[0];var b:Vector3=triangle[1];var c:Vector3=triangle[2]
+				if (b-a).cross(c-a).dot(exterior)>0.0:
+					var swap:Vector3=b;b=c;c=swap
+				assert((b-a).cross(c-a).length_squared()>0.000000000001)
+				for point:Vector3 in [a,b,c]:
+					vertices.append(point);normals.append(exterior);uvs.append(Vector2(point.x,point.z))
+			var arrays:Array=[];arrays.resize(Mesh.ARRAY_MAX)
+			arrays[Mesh.ARRAY_VERTEX]=vertices;arrays[Mesh.ARRAY_NORMAL]=normals;arrays[Mesh.ARRAY_TEX_UV]=uvs
+			var mesh:=ArrayMesh.new();mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
+			var node:=MeshInstance3D.new();node.mesh=mesh;node.material_override=m;node.name=label
+			node.set_meta("construction_detail","closure_crossing_split")
+			node.set_meta("closure_orientation",orientation.duplicate(true))
+			root.add_child(node,true)
+			return
+	var ar:Array=[];ar.resize(Mesh.ARRAY_MAX);var vs:=PackedVector3Array();var ns:=PackedVector3Array();var uv:=PackedVector2Array()
+	var normal:Vector3=(pts[1]-pts[0]).cross(pts[2]-pts[0]).normalized()
+	var order:Array=[0,2,1,0,3,2]
+	if not orientation.is_empty() and normal.dot(orientation.outward)<0.0:
+		normal=-normal;order=[0,1,2,0,2,3]
+	for i in order:vs.append(pts[i]);ns.append(normal);uv.append(Vector2(pts[i].x,pts[i].z))
+	ar[Mesh.ARRAY_VERTEX]=vs;ar[Mesh.ARRAY_NORMAL]=ns;ar[Mesh.ARRAY_TEX_UV]=uv
+	var mesh:=ArrayMesh.new();mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,ar);var n:=MeshInstance3D.new();n.mesh=mesh;n.material_override=m
+	if not label.is_empty():n.name=label
+	if not orientation.is_empty():n.set_meta("closure_orientation",orientation.duplicate(true))
+	root.add_child(n,true)
+static func roof_material()->ShaderMaterial:
+	var sh:=Shader.new();sh.code="""shader_type spatial;
+	varying vec3 wp;
+	void vertex(){wp=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;}
+	void fragment(){
+	 vec2 p=vec2(dot(wp.xz,vec2(-0.3108,0.9505)),dot(wp.xz,vec2(-0.9505,-0.3108)));
+	 vec2 cell=floor(p/vec2(0.42,0.20));float grain=fract(sin(dot(cell,vec2(12.9898,78.233)))*43758.5453);
+	 float course=fract(p.y/0.20);float aa=max(fwidth(p.y/0.20),0.035);float seam=1.0-smoothstep(0.025,0.025+aa,course);
+	 ALBEDO=vec3(0.30,0.315,0.265)*(0.94+grain*0.12)*(1.0-seam*0.09);ROUGHNESS=0.94;
+	}"""
+	var m:=ShaderMaterial.new();m.shader=sh;return m
+static func roof_y(depth:float,lo:float,hi:float,base:float)->float:
+	return base+5.55+1.12*maxf(0.0,1.0-absf((depth-(lo+hi)*0.5)/((hi-lo)*0.5)))
+static func roof_edge(root:Node3D,a:Vector3,b:Vector3,m:Material)->void:
+	if Vector2(b.x-a.x,b.z-a.z).length()<0.001:return
+	var along:Vector3=(b-a).normalized();var side:=along.cross(Vector3.UP).normalized();var up:=side.cross(along).normalized()
+	var mesh:=BoxMesh.new();mesh.size=Vector3(a.distance_to(b),0.14,0.13)
+	var n:=MeshInstance3D.new();n.mesh=mesh;n.material_override=m;n.transform=Transform3D(Basis(along,up,side),(a+b)*0.5-Vector3.UP*0.09);n.name="RoofFascia";root.add_child(n,true)
+static func exterior_quad(root:Node3D,pts:Array,m:Material,outward:Vector3,kind:String)->void:
+	var ar:=[];ar.resize(Mesh.ARRAY_MAX)
+	var vertices:=PackedVector3Array();var normals:=PackedVector3Array()
+	for ids:Array in [[0,1,2],[0,2,3]]:
+		var a:Vector3=pts[ids[0]];var b:Vector3=pts[ids[1]];var c:Vector3=pts[ids[2]]
+		var cross:Vector3=(b-a).cross(c-a)
