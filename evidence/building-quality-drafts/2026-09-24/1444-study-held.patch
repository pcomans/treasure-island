+++ b/game/scripts/world/facades/croaker_1444_shelter_visibility.gd
@@ -0,0 +1,77 @@
+extends RefCounted
+# Dedicated local ambient visibility on existing inward shelter faces only.
+# Geometry, albedo, roughness, direct sun and global environment stay unchanged.
+const FIELD_PATH := "res://game/scripts/world/facades/croaker_1444_shelter_visibility.json"
+const DECLARATIONS := """
+uniform sampler2D shelter_visibility : filter_linear, repeat_disable;
+uniform vec3 shelter_face_normal;
+uniform vec3 shelter_u_axis;
+uniform vec3 shelter_v_axis;
+uniform vec2 shelter_span;
+uniform vec2 shelter_grid;
+varying vec3 shelter_position;
+varying vec3 shelter_normal;
+"""
+const AMBIENT_FRAGMENT := """
+	AO = 1.0;
+	AO_LIGHT_AFFECT = 0.0;
+	if (dot(normalize(shelter_normal), shelter_face_normal) > 0.99) {
+		vec2 location = vec2(dot(shelter_position,shelter_u_axis),dot(shelter_position,shelter_v_axis));
+		vec2 unit_uv = clamp(location/shelter_span+vec2(0.5),vec2(0.0),vec2(1.0));
+		vec2 texel_uv = (unit_uv*(shelter_grid-vec2(1.0))+vec2(0.5))/shelter_grid;
+		AO = texture(shelter_visibility,texel_uv).r;
+	}
+"""
+
+static func _vector(values:Array)->Vector3:
+	return Vector3(values[0],values[1],values[2])
+
+static func _material(original:Material,field:Dictionary,size:Vector3)->ShaderMaterial:
+	var original_code:String
+	if original is ShaderMaterial:
+		original_code=original.shader.code
+	else:
+		assert(original is StandardMaterial3D)
+		assert(original.cull_mode==0 and original.shading_mode==1 and original.transparency==0)
+		original_code="""shader_type spatial;
+		uniform vec4 original_color : source_color;
+		uniform float original_roughness;
+		void vertex(){}
+		void fragment(){ALBEDO=original_color.rgb;ROUGHNESS=original_roughness;METALLIC=0.0;SPECULAR=0.5;}"""
+	var shader:=Shader.new()
+	shader.code=original_code.replace("shader_type spatial;","shader_type spatial;"+DECLARATIONS).replace("void vertex(){","void vertex(){shelter_position=VERTEX;shelter_normal=NORMAL;").replace("void fragment(){","void fragment(){"+AMBIENT_FRAGMENT)
+	var material:=ShaderMaterial.new()
+	material.shader=shader
+	if original is StandardMaterial3D:
+		material.set_shader_parameter("original_color",original.albedo_color)
+		material.set_shader_parameter("original_roughness",original.roughness)
+	var values:=PackedFloat32Array(field.values)
+	var image:=Image.create_from_data(int(field.width),int(field.height),false,Image.FORMAT_RF,values.to_byte_array())
+	var texture:=ImageTexture.create_from_image(image)
+	material.set_shader_parameter("shelter_visibility",texture)
+	material.set_shader_parameter("shelter_face_normal",_vector(field.normal_local))
+	var u_axis:=Vector3.ZERO
+	var v_axis:=Vector3.ZERO
+	u_axis[int(field.uv_axes[0])]=1.0
+	v_axis[int(field.uv_axes[1])]=1.0
+	material.set_shader_parameter("shelter_u_axis",u_axis)
+	material.set_shader_parameter("shelter_v_axis",v_axis)
+	material.set_shader_parameter("shelter_span",Vector2(size[int(field.uv_axes[0])],size[int(field.uv_axes[1])]))
+	material.set_shader_parameter("shelter_grid",Vector2(field.width,field.height))
+	return material
+
+static func apply(root:Node3D)->void:
+	var data:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(FIELD_PATH))
+	var bindings:Array=[]
+	for field in data.fields:
+		var expected_origin:Vector3=_vector(field.binding.origin)
+		var expected_size:Vector3=_vector(field.binding.size)
+		var matches:Array=[]
+		for node in root.find_children("*","MeshInstance3D",true,false):
+			if node.mesh is BoxMesh and node.position.distance_to(expected_origin)<0.0001 and node.mesh.size.distance_to(expected_size)<0.0001:matches.append(node)
+		assert(matches.size()==1,"Shelter visibility requires exact one native host for "+str(field.label))
+		var node:MeshInstance3D=matches[0]
+		node.material_override=_material(node.material_override,field,node.mesh.size)
+		bindings.append({"label":field.label,"child_index":node.get_index(),"origin":[node.position.x,node.position.y,node.position.z],"size":[node.mesh.size.x,node.mesh.size.y,node.mesh.size.z],"width":field.width,"height":field.height})
+	root.set_meta("shelter_visibility_bindings",bindings)
+	root.set_meta("shelter_visibility_sha256",FileAccess.get_sha256(FIELD_PATH))
