+	var rechecked: Dictionary=prepare_chunk_records({"chunk_id":"x_1__z_1","records":prepared.source_records.values()})
+	if not bool(rechecked.get("ok",false)):return rechecked
+	var pair: Dictionary=FINAL_CANDIDATE.build(FINAL_ROOF_SPAN)
+	if not bool(pair.get("ok",false)):return pair
+	var results: Dictionary={}
+	for key: String in [TARGET_WALL_KEY,TARGET_ROOF_KEY]:
+		var node: Node3D=pair.wall if key==TARGET_WALL_KEY else pair.roof
+		node.remove_meta("candidate_unaccepted")
+		node.set_meta("building_3_massing_override",true)
+		node.set_meta("runtime_supersedes_generated_placeholder",true)
+		node.set_meta("horizontal_source_geometry_preserved",true)
+		node.set_meta("foundation_geometry_preserved",key==TARGET_WALL_KEY)
+		node.set_meta("corrected_nrhp_id","08000083")
+		node.set_meta("frozen_osm_nrhp_ref","08000081")
+		node.set_meta("frozen_osm_nrhp_ref_role","provenance_only_incorrect_for_building_3")
+		node.set_meta("production_inference_reversible",true)
