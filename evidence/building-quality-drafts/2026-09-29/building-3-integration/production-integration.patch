+		node.set_meta("roof_longitudinal_span",FINAL_ROOF_SPAN)
+		var result: Dictionary={"ok":true,"node":node,"mesh_instances":0,"surfaces":0,"triangles":0,"static_bodies":0,"shapes":0}
+		for child: Node in node.get_children():
+			if child is MeshInstance3D:
+				result.mesh_instances+=1;result.surfaces+=child.mesh.get_surface_count()
+				for surface_index in child.mesh.get_surface_count():
+					var arrays: Array=child.mesh.surface_get_arrays(surface_index)
+					var indices:=PackedInt32Array()
+					if arrays[Mesh.ARRAY_INDEX]!=null:indices=arrays[Mesh.ARRAY_INDEX]
+					result.triangles+=indices.size()/3 if not indices.is_empty() else (arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size()/3
+			if child is StaticBody3D:result.static_bodies+=1;result.shapes+=child.get_shape_owners().size()
+		results[key]=result
+	if int(results[TARGET_WALL_KEY].triangles)!=1204 or int(results[TARGET_ROOF_KEY].triangles)!=6077:
+		pair.wall.free();pair.roof.free();return _pair_failure("Final B3 measured topology drifted")
+	return {"ok":true,"contains_target":true,"source_records":rechecked.source_records,"records":results,"pending_keys":{TARGET_WALL_KEY:true,TARGET_ROOF_KEY:true}}
+
+static func consume_record(record: Dictionary,plan: Dictionary) -> Dictionary:
+	var key: String=str(record.get("object_key",""))
+	if not bool(plan.get("ok",false)) or not bool(plan.get("contains_target",false)) or not (plan.get("pending_keys",{}) as Dictionary).has(key):return _pair_failure("B3 requires an unconsumed paired plan")
+	if record!=plan.source_records[key]:return _pair_failure("B3 consumed record differs from sealed supplied pair")
+	var result: Dictionary=plan.records[key]
+	plan.pending_keys.erase(key);plan.records.erase(key)
+	return result
+
+static func plan_was_fully_consumed(plan: Dictionary) -> bool:
+	return not bool(plan.get("contains_target",false)) or (plan.get("pending_keys",{}) as Dictionary).is_empty()
+
+static func free_unconsumed(plan: Dictionary) -> void:
+	var records: Dictionary=plan.get("records",{})
+	for result: Dictionary in records.values():
+		var node: Node=result.get("node")
+		if is_instance_valid(node) and not node.is_inside_tree():node.free()
+	records.clear();(plan.get("pending_keys",{}) as Dictionary).clear()
+
+static func _pair_failure(message: String) -> Dictionary:
+	return {"ok":false,"code":"building_3_paired_attachment","message":message,"source_keys":[TARGET_SOURCE_KEY]}
