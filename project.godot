; Engine configuration file.
; Godot 4.7.2, Forward+ (the default rendering method); web exports use
; Compatibility (WebGL 2), the only renderer Godot's web platform has.
; The game's name is config/name (the window title, the web page's title and
; the Mac app's name). Players' saved settings (user://) stay in the folder Godot
; made for the game's earlier name, Treasure Island First Playable:
; config/custom_user_dir_name pins Godot's own default path for that name on each
; platform (godot/app_userdata/<name> in the data folder; Godot/ on macOS and
; Windows). game/tests/headless_startup_configuration_contract.gd checks both.
; The web build's reflection atlas has a slot for each reflection probe the world
; has, Mersea's two (rendering/reflections/reflection_atlas/reflection_count.web):
; the Compatibility renderer allocates every slot when the first probe renders, two
; 256 px cubemaps with their mipmaps (4 MiB) a slot, so Godot's default of 64 held
; 256 MiB of WebGL textures. A probe left without a slot gets no reflection, and
; engine errors every frame; game/tests/headless_gameplay_contract.gd fails when
; the world has more probes than the web has slots. Desktop builds keep the default.
config_version=5

[application]

config/name="Grand Treasure Island"
config/description="Grand Treasure Island: walk, run, jetpack and drive round Treasure Island, San Francisco."
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Treasure Island First Playable"
config/custom_user_dir_name.macos="Godot/app_userdata/Treasure Island First Playable"
config/custom_user_dir_name.windows="Godot/app_userdata/Treasure Island First Playable"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://game/resources/ui/app_icon_360.png"

[audio]

buses/default_bus_layout="res://game/resources/audio/bus_layout.tres"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/generated_world_export/plugin.cfg")

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

