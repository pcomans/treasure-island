[layer_names]

3d_physics/layer_1="world_solid"
3d_physics/layer_2="player"
3d_physics/layer_3="spray_ray_surface"
3d_physics/layer_4="street_prop"
3d_physics/layer_5="loose_prop"
3d_physics/layer_6="car_ground"
3d_physics/layer_7="reach"
3d_render/layer_1="world_visible"
3d_render/layer_2="building_wall_decal"
3d_render/layer_6="interior"
3d_render/layer_20="avatar_fill"

[physics]

common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method.web="gl_compatibility"
reflections/reflection_atlas/reflection_count.web=2
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.46, 0.69, 0.86, 1)

[shader_globals]

sky_cloud_drift={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
horizon_light={
"type": "float",
"value": 1.0
}
vegetation_sheen={
"type": "float",
"value": 1.0
}
horizon_haze={
"type": "vec3",
"value": Vector3(0.5070785, 0.6038273, 0.7105665)
}
parked_lamps={
"type": "float",
"value": 1.0
}

[treasure_island]

ground_dressing/density="medium"
street_detail/enabled=true
street_detail/layers="vegetation,furniture,fences,clutter"
time_of_day/enabled=true
