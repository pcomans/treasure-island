{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treasure-island.local/schemas/facade-recognition-catalog.schema.json",
  "title": "Treasure Island physical-building facade recognition catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "active_runtime_adapters",
    "catalog_id",
    "capture_contracts",
    "checked_date",
    "claim_vocabulary",
    "compiler_contract",
    "expected_counts",
    "identity_evidence_records",
    "legacy_adapters",
    "schema_version",
    "source_contract",
    "unit_seed",
    "units"
  ],
  "properties": {
    "$schema": {
      "const": "./facade-recognition-catalog.schema.json"
    },
    "active_runtime_adapters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/active_runtime_adapter"
      }
    },
    "catalog_id": {
      "const": "treasure-island-physical-building-recognition"
    },
    "capture_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capture_contract"
      }
    },
    "checked_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "claim_vocabulary": {
      "$ref": "#/$defs/claim_vocabulary"
    },
    "compiler_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emitted_runtime_schema_version",
        "required_compiler_version",
        "unknown_version_policy"
      ],
      "properties": {
        "emitted_runtime_schema_version": {
          "const": "ti.facade-runtime-registry/7"
        },
        "required_compiler_version": {
          "const": "1.6.0"
        },
        "unknown_version_policy": {
          "const": "reject"
        }
      }
    },
    "expected_counts": {
      "$ref": "#/$defs/expected_counts"
    },
    "identity_evidence_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity_evidence_record"
      }
    },
    "legacy_adapters": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/legacy_adapter"
      }
    },
    "schema_version": {
      "const": "ti.facade-recognition-catalog/7"
    },
    "source_contract": {
      "$ref": "#/$defs/source_contract"
    },
    "unit_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_input",
        "strategy"
      ],
      "properties": {
        "immutable_input": {
          "const": true
        },
        "strategy": {
          "const": "immutable_receiver_inventory_physical_units_v1"
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 213,
      "maxItems": 213,
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_key": {
      "type": "string",
      "pattern": "^[nwr][0-9]+$"
    },
    "receiver_key": {
      "type": "string",
      "pattern": "^building(?:-composite)?:.+:wall$"
    },
    "expected_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_runtime_adapter_receivers",
        "building_footprints",
        "building_parts",
        "composite_units",
        "direct_wall_receivers",
        "legacy_adapter_receivers",
        "recognition_units",
        "runtime_adapter_receivers",
        "source_records",
        "standalone_units",
        "visible_wall_runs"
      ],
      "properties": {
        "active_runtime_adapter_receivers": {
          "const": 6
        },
        "building_footprints": {
          "const": 213
        },
        "building_parts": {
          "const": 2
        },
        "composite_units": {
          "const": 1
        },
        "direct_wall_receivers": {
          "const": 214
        },
        "legacy_adapter_receivers": {
          "const": 9
        },
        "recognition_units": {
          "const": 213
        },
        "runtime_adapter_receivers": {
          "const": 15
        },
        "source_records": {
          "const": 215
        },
        "standalone_units": {
          "const": 212
        },
        "visible_wall_runs": {
          "const": 4971
        }
      }
    },
    "claim_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_built_fidelity",
        "game_distinctive",
        "real_world_recognition_exclusions",
        "receiver_complete",
        "reference_recognizable"
      ],
      "properties": {
        "as_built_fidelity": {
          "type": "string",
          "minLength": 1
        },
        "game_distinctive": {
          "type": "string",
          "minLength": 1
        },
        "real_world_recognition_exclusions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "receiver_complete": {
          "type": "string",
          "minLength": 1
        },
        "reference_recognizable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_content_sha256",
        "generated_manifest_schema_version",
        "generated_manifest_sha256",
        "inventory_schema_version",
        "inventory_sha256"
      ],
      "properties": {
        "generated_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generated_manifest_schema_version": {
          "const": "ti.godot-world/2"
        },
        "generated_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_schema_version": {
          "const": "ti.facade-receiver-inventory/1"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "active_runtime_adapter": {
      "anyOf": [
        {
          "$ref": "#/$defs/building_1_active_runtime_adapter"
        },
        {
          "$ref": "#/$defs/building_3_active_runtime_adapter"
        },
        {
          "$ref": "#/$defs/isle_house_active_runtime_adapter"
        },
        {
          "$ref": "#/$defs/navy_chapel_active_runtime_adapter"
        },
        {
          "$ref": "#/$defs/d1_b201_active_runtime_adapter"
        }
      ]
    },
    "building_1_active_runtime_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "content_classification", "receiver_key", "recognition_acceptance_authority", "recognition_acceptance_status", "review_status", "review_status_scope", "runtime_adapter_path", "runtime_asset_paths", "runtime_config_path", "runtime_dispatch_path", "source_key", "whole_building_recognizability_imported"],
      "properties": {
        "adapter_id": {"type": "string", "pattern": "^active-adapter:building-1-hero:"},
        "content_classification": {"const": "active_target_specific_hero_replacement"},
        "receiver_key": {"enum": ["building:r16681702:wall", "building:w1222720021:wall"]},
        "recognition_acceptance_authority": {"const": "physical_unit_claim_and_independent_acceptance_record"},
        "recognition_acceptance_status": {"const": "accepted"},
        "review_status": {"const": "pending_independent_original_detail_review"},
        "review_status_scope": {"const": "runtime_asset_original_detail_provenance_only_not_reference_recognition"},
        "runtime_adapter_path": {"const": "game/scripts/world/facades/building_1_hero_model.gd"},
        "runtime_asset_paths": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "contains": {"const": "game/resources/facades/building_1_public_front_believability.json"},
          "minContains": 1,
          "maxContains": 1,
          "items": {
            "anyOf": [
              {"const": "game/resources/facades/building_1_public_front_believability.json"},
              {"type": "string", "pattern": "^game/resources/materials/world/building_1/"}
            ]
          }
        },
        "runtime_config_path": {"const": "game/resources/facades/building_1_hero_model.json"},
        "runtime_dispatch_path": {"const": "game/scripts/world/world_chunk_builder.gd"},
        "source_key": {"enum": ["r16681702", "w1222720021"]},
        "whole_building_recognizability_imported": {"const": false}
      }
    },
    "building_3_active_runtime_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "content_classification", "receiver_key", "recognition_acceptance_authority", "recognition_acceptance_status", "review_status", "review_status_scope", "runtime_adapter_path", "runtime_asset_paths", "runtime_config_path", "runtime_dispatch_path", "source_key", "whole_building_recognizability_imported"],
      "properties": {
        "adapter_id": {"const": "active-adapter:building-3-hero:building:w34313540:wall"},
        "content_classification": {"const": "active_target_specific_hero_replacement"},
        "receiver_key": {"const": "building:w34313540:wall"},
        "recognition_acceptance_authority": {"const": "physical_unit_claim_and_independent_acceptance_record"},
        "recognition_acceptance_status": {"const": "accepted"},
        "review_status": {"const": "pending_independent_original_detail_review"},
        "review_status_scope": {"const": "runtime_asset_original_detail_provenance_only_not_reference_recognition"},
        "runtime_adapter_path": {"const": "game/scripts/world/massing/building_3_600_california_massing.gd"},
        "runtime_asset_paths": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^game/(?:resources/facades|resources/materials/world/building_3|scenes/world/facades/building_3|scripts/world/facades)/"}
        },
        "runtime_config_path": {"const": "game/resources/facades/building_3_hero_massing.json"},
        "runtime_dispatch_path": {"const": "game/scripts/world/world_chunk_builder.gd"},
        "source_key": {"const": "w34313540"},
        "whole_building_recognizability_imported": {"const": false}
      }
    },
    "isle_house_active_runtime_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "content_classification", "receiver_key", "recognition_acceptance_authority", "recognition_acceptance_status", "review_status", "review_status_scope", "runtime_adapter_path", "runtime_asset_paths", "runtime_config_path", "runtime_dispatch_path", "source_key", "whole_building_recognizability_imported"],
      "properties": {
        "adapter_id": {"const": "active-adapter:isle-house-variant-c:building-composite:w1249412094:w1282547787:wall"},
        "content_classification": {"const": "active_target_specific_composite_part_replacement"},
        "receiver_key": {"const": "building-composite:w1249412094:w1282547787:wall"},
        "recognition_acceptance_authority": {"const": "physical_unit_claim_and_independent_acceptance_record"},
        "recognition_acceptance_status": {"const": "accepted"},
        "review_status": {"const": "independent_exact_current_live_pass"},
        "review_status_scope": {"const": "runtime_asset_original_detail_provenance_only_not_reference_recognition"},
        "runtime_adapter_path": {"const": "game/scripts/world/facades/isle_house_composite_repair_variant_c_live_attachment.gd"},
        "runtime_asset_paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^game/scripts/world/facades/isle_house_composite_repair_variant_c_(?:repair_only_factory|standalone_v1)\\.gd$"}
        },
        "runtime_config_path": {"const": "game/resources/facades/isle_house_composite_repair_variant_c_standalone_v1.json"},
        "runtime_dispatch_path": {"const": "game/scripts/world/world_chunk_builder.gd"},
        "source_key": {"const": "w1282547787"},
        "whole_building_recognizability_imported": {"const": false}
      }
    },
    "navy_chapel_active_runtime_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "content_classification", "receiver_key", "recognition_acceptance_authority", "recognition_acceptance_status", "review_status", "review_status_scope", "runtime_adapter_path", "runtime_asset_paths", "runtime_config_path", "runtime_dispatch_path", "source_key", "whole_building_recognizability_imported"],
      "properties": {
        "adapter_id": {"const": "active-adapter:navy-chapel-187:building:w291189336:wall"},
        "content_classification": {"const": "active_target_specific_paired_wall_roof_replacement"},
        "receiver_key": {"const": "building:w291189336:wall"},
        "recognition_acceptance_authority": {"const": "physical_unit_claim_and_independent_acceptance_record"},
        "recognition_acceptance_status": {"const": "accepted"},
        "review_status": {"const": "independent_exact_current_live_pass"},
        "review_status_scope": {"const": "runtime_asset_original_detail_provenance_only_not_reference_recognition"},
        "runtime_adapter_path": {"const": "game/scripts/world/facades/navy_chapel_187_live_replacement.gd"},
        "runtime_asset_paths": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^game/(?:resources/materials/world/navy_chapel_187|scripts/world/facades/navy_chapel_187_standalone_hero_prototype\\.gd)"}
        },
        "runtime_config_path": {"const": "game/resources/facades/navy_chapel_187_standalone_hero_prototype.json"},
        "runtime_dispatch_path": {"const": "game/scripts/world/world_chunk_builder.gd"},
        "source_key": {"const": "w291189336"},
        "whole_building_recognizability_imported": {"const": false}
      }
    },
    "d1_b201_active_runtime_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "content_classification", "receiver_key", "recognition_acceptance_authority", "recognition_acceptance_status", "review_status", "review_status_scope", "runtime_adapter_path", "runtime_asset_paths", "runtime_config_path", "runtime_dispatch_path", "source_key", "whole_building_recognizability_imported"],
      "properties": {
        "adapter_id": {"const": "active-adapter:d1-b201-live:building:w34313545:wall"},
        "content_classification": {"const": "active_target_specific_receiver_host_partition_plus_render_only_attachment"},
        "receiver_key": {"const": "building:w34313545:wall"},
        "recognition_acceptance_authority": {"const": "physical_unit_claim_and_independent_acceptance_record"},
        "recognition_acceptance_status": {"const": "accepted"},
        "review_status": {"const": "independent_exact_current_live_pass"},
        "review_status_scope": {"const": "runtime_asset_original_detail_provenance_only_not_reference_recognition"},
        "runtime_adapter_path": {"const": "game/scripts/world/facades/d1_b201_live_attachment.gd"},
        "runtime_asset_paths": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^game/resources/materials/world/d1_current/(?:b201_(?:green_hierarchy|muted_rust_post|service_leaf|warm_wall)|shared_(?:dark_glass|pale_frame))\\.tres$"}
        },
        "runtime_config_path": {"const": "game/resources/facades/d1_current/d1_b201_live_attachment.json"},
        "runtime_dispatch_path": {"const": "game/scripts/world/world_chunk_builder.gd"},
        "source_key": {"const": "w34313545"},
        "whole_building_recognizability_imported": {"const": false}
      }
    },
    "legacy_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "import_basis",
        "receiver_key",
        "source_key",
        "whole_building_recognizability_imported"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^legacy-adapter:"
        },
        "import_basis": {
          "const": "inventory_accepted_target_specific_runtime_attachment"
        },
        "receiver_key": {
          "$ref": "#/$defs/receiver_key"
        },
        "source_key": {
          "$ref": "#/$defs/source_key"
        },
        "whole_building_recognizability_imported": {
          "const": false
        }
      }
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source_key"
      ],
      "properties": {
        "role": {
          "enum": [
            "building_part_within_parent_footprint",
            "composite_parent_footprint",
            "standalone_building_footprint"
          ]
        },
        "source_key": {
          "$ref": "#/$defs/source_key"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address_completeness",
        "address_evidence",
        "canonical_name",
        "currentness_claimed",
        "formatted_address",
        "identity_confidence",
        "name_evidence"
      ],
      "properties": {
        "address_completeness": {
          "type": [
            "string",
            "null"
          ]
        },
        "address_evidence": {
          "type": "boolean"
        },
        "canonical_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentness_claimed": {
          "const": false
        },
        "formatted_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_confidence": {
          "type": "string",
          "minLength": 1
        },
        "name_evidence": {
          "type": "boolean"
        }
      }
    },
    "identity_evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "checked_date",
        "currentness_claimed",
        "evidence_class",
        "evidenced_value",
        "frozen_field",
        "frozen_value",
        "primary_source_locator",
        "research_packet_path",
        "runtime_visibility",
        "unit_id"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^identity-assertion:"
        },
        "checked_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "currentness_claimed": {
          "type": "boolean"
        },
        "evidence_class": {
          "enum": [
            "authoritative_correction",
            "authoritative_current_identity",
            "reference_identity_context"
          ]
        },
        "evidenced_value": {
          "type": "string",
          "minLength": 1
        },
        "frozen_field": {
          "type": "string",
          "minLength": 1
        },
        "frozen_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_source_locator": {
          "type": "string",
          "pattern": "^https://"
        },
        "research_packet_path": {
          "type": "string",
          "pattern": "^discovery/facades/"
        },
        "runtime_visibility": {
          "enum": [
            "source_only",
            "summary_only"
          ]
        },
        "unit_id": {
          "type": "string",
          "pattern": "^physical-building:[nwr][0-9]+$"
        }
      }
    },
    "capture_pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aim_target_m",
        "camera_position_m",
        "fov_degrees",
        "player_position_m"
      ],
      "properties": {
        "aim_target_m": {
          "$ref": "#/$defs/vector3"
        },
        "camera_position_m": {
          "$ref": "#/$defs/vector3"
        },
        "fov_degrees": {
          "type": "number",
          "minimum": 35,
          "maximum": 90
        },
        "player_position_m": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "capture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternate_pose",
        "ordinary_third_person_required",
        "primary_pose",
        "required_cue_ids",
        "status",
        "unit_id"
      ],
      "properties": {
        "alternate_pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/capture_pose"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinary_third_person_required": {
          "const": true
        },
        "primary_pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/capture_pose"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_cue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "blocked",
            "configured"
          ]
        },
        "unit_id": {
          "type": "string",
          "pattern": "^physical-building:[nwr][0-9]+$"
        }
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "claim_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_built_fidelity",
        "game_distinctive",
        "receiver_complete",
        "reference_recognizable"
      ],
      "properties": {
        "as_built_fidelity": {
          "enum": [
            "unclaimed",
            "limited",
            "claimed"
          ]
        },
        "game_distinctive": {
          "enum": [
            "not_evaluated",
            "accepted",
            "rejected"
          ]
        },
        "receiver_complete": {
          "const": "verified"
        },
        "reference_recognizable": {
          "enum": [
            "not_evaluated",
            "accepted",
            "rejected",
            "blocked"
          ]
        }
      }
    },
    "reference_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "observed_regions",
        "pixels_packaged",
        "source_locator",
        "supports"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pixels_packaged": {
          "const": false
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recognition_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_motif",
        "cue_id",
        "cue_kind",
        "evidence_class",
        "receiver_key",
        "reference_ids",
        "run_indices"
      ],
      "properties": {
        "complete_motif": {
          "type": "boolean"
        },
        "cue_id": {
          "type": "string",
          "minLength": 1
        },
        "cue_kind": {
          "enum": [
            "homogeneous_material_tile",
            "architectural_pattern_tile",
            "module_atlas",
            "unique_elevation"
          ]
        },
        "evidence_class": {
          "enum": [
            "reference_observation",
            "production_inference",
            "verified_fact"
          ]
        },
        "receiver_key": {
          "$ref": "#/$defs/receiver_key"
        },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "run_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "receiver_key",
        "run_indices"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "receiver_key": {
          "$ref": "#/$defs/receiver_key"
        },
        "run_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "acceptance_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_manifest_sha256",
        "review_id",
        "review_kind",
        "review_receipt_sha256",
        "status"
      ],
      "properties": {
        "evidence_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "review_kind": {
          "enum": [
            "as_built_fidelity",
            "independent_game_art",
            "independent_reference_recognition",
            "mechanical_receiver"
          ]
        },
        "review_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "accept",
            "reject"
          ]
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_records",
        "anchor_source_key",
        "claim_status",
        "human_dependency_ids",
        "identity",
        "legacy_adapter_ids",
        "protected_scopes",
        "receiver_keys",
        "recognition_cues",
        "reference_records",
        "reference_state",
        "source_records",
        "unit_id",
        "unit_kind"
      ],
      "properties": {
        "acceptance_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance_record"
          }
        },
        "anchor_source_key": {
          "$ref": "#/$defs/source_key"
        },
        "claim_status": {
          "$ref": "#/$defs/claim_status"
        },
        "human_dependency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^HUMAN-[0-9]+$"
          }
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "legacy_adapter_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^legacy-adapter:"
          }
        },
        "protected_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protected_scope"
          }
        },
        "receiver_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/receiver_key"
          }
        },
        "recognition_cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recognition_cue"
          }
        },
        "reference_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference_record"
          }
        },
        "reference_state": {
          "enum": [
            "identity_or_reference_research_required",
            "reference_research_unassessed",
            "reference_ready",
            "reference_blocked"
          ]
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/source_record"
          }
        },
        "unit_id": {
          "type": "string",
          "pattern": "^physical-building:[nwr][0-9]+$"
        },
        "unit_kind": {
          "enum": [
            "standalone_building",
            "composite_building"
          ]
        }
      }
    }
  }
}
